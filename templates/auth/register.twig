{% extends 'layout.twig' %}

{% block title %}Регистрация · {{ appName }}{% endblock %}

{% block content %}
    <section class="auth-panel" aria-labelledby="page-title">
        <p class="eyebrow">Ваше пространство</p>
        <h1 id="page-title">Создать аккаунт</h1>
        <p class="intro-copy">Заполните данные, чтобы начать.</p>
        {% if error %}<p class="form-error" id="form-error" role="alert">{{ error }}</p>{% endif %}
        <form class="auth-form" method="post" action="/register" data-password-confirmation>
            <input type="hidden" name="_token" value="{{ csrf_token() }}">
            <div class="form-field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required value="{{ email }}" {% if error %}aria-describedby="form-error"{% endif %}>
            </div>
            <div class="form-field">
                <label for="password">Пароль</label>
                <div class="password-control">
                    <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="72" required data-password>
                    <button class="password-toggle" type="button" data-password-toggle aria-controls="password" aria-pressed="false">Показать</button>
                </div>
                <span class="field-hint">От 12 до 72 символов в UTF-8.</span>
            </div>
            <div class="form-field">
                <label for="password_confirmation">Повторите пароль</label>
                <div class="password-control">
                    <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" minlength="12" maxlength="72" required data-password-confirmation-input>
                    <button class="password-toggle" type="button" data-password-toggle aria-controls="password_confirmation" aria-pressed="false">Показать</button>
                </div>
            </div>
            <button class="primary-action" type="submit">Создать аккаунт</button>
        </form>
        <p class="form-footnote">Уже зарегистрированы? <a href="/login">Войти</a></p>
    </section>
{% endblock %}