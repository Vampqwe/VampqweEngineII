{% extends 'layout.twig' %}

{% block title %}Аккаунт · {{ appName }}{% endblock %}

{% block content %}
    <h1>Аккаунт</h1>
    <p>{{ user.email }}</p>
    <form method="post" action="/logout">
        <input type="hidden" name="_token" value="{{ csrf_token() }}">
        <button type="submit">Выйти</button>
    </form>
{% endblock %}