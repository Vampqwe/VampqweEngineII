{
    "name": "vampqwe/engine",
    "description": "A lightweight, extensible MVC engine for PHP websites.",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.0",
        "symfony/cache": "^7.0",
        "symfony/console": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/rate-limiter": "^7.0",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Vampqwe\\Engine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vampqwe\\Engine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src public config bootstrap tests bin database -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8000 -t public"
    },
    "config": {
        "sort-packages": true
    }
}