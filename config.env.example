APP_NAME="Vampqwe Engine"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vampqwe
MYSQL_USERNAME=root
MYSQL_PASSWORD=

MIGRATIONS_PATH=database/migrations
SESSION_SECURE_COOKIE=false
AUTH_PASSWORD_MIN_BYTES=12
AUTH_PASSWORD_MAX_BYTES=72
AUTH_LOGIN_LIMIT_PER_ACCOUNT=5
AUTH_LOGIN_LIMIT_PER_IP=30
AUTH_REGISTER_LIMIT_PER_IP=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_CACHE_PATH=var/cache/rate-limiter